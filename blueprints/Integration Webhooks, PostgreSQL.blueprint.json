                        "role": "user",
                        "parts": [
                            {
                                "text": "Analise esta notificação de compra e extraia categoria, valor e loja.\r\n\r\nNotificação:\r\n{{1.value}}\r\nRegras:\r\n- categoria deve ser apenas uma destas: Alimentação, Transporte, Lazer, Saúde, Educação, Moradia, Compras, Outros\r\n- valor deve ser numérico\r\n- loja deve ser o nome do estabelecimento\r\n- Se aparecer padaria, mercado, supermercado, restaurante, lanchonete ou delivery, use Alimentação\r\n- Se aparecer posto, uber, 99, pedágio, estacionamento ou locadora, use Transporte\r\n- Se aparecer farmácia, clínica, hospital ou laboratório, use Saúde\r\n- Se não tiver certeza, use Outros\r\n- Se não encontrar valor, use 0\r\n- Se não encontrar loja, use Desconhecido\r\n",
                                "type": "text"
                            }
                        ]
                    }
                ],
                "responseSchema": [
                    {
                        "type": "string",
                        "array": false,
                        "required": true,
                        "description": "Categoria da compra. Deve ser apenas uma destas: Alimentação, Transporte, Lazer, Saúde, Educação, Moradia, Compras, Outros.\r\n",
